# Provider: auto (default) | gemini | openai
IMAGE_PROVIDER=auto

# Gemini image editing (Nano Banana / recommended for FACS)
GEMINI_API_KEY=AQ.여기에_본인_키
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI image editing (alternative)
OPENAI_API_KEY=sk-...
OPENAI_IMAGE_MODEL=gpt-image-1

# FORCE_MOCK=true
# LOG_USAGE_JSONL=true

# Daily free transform limit (IP + browser session cookie)
DAILY_FREE_LIMIT=3
# SKIP_DAILY_QUOTA=true

# Dev only: grant daily paid credits without checkout (resets each KST day)
# GRANT_DAILY_CREDITS=10

# --- Credit persistence ---
# Local default: SQLite file at ./data/credits.db (server restart safe)
# CREDIT_DB_PATH=./data/credits.db
# CREDIT_STORE=memory

# Production (Vercel + Upstash Redis integration):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Toss Payments
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_여기에_클라이언트키
TOSS_SECRET_KEY=test_sk_여기에_시크릿키
NEXT_PUBLIC_APP_URL=http://localhost:3000
# PAYMENT_MOCK=true

# Auth.js (Google + Kakao login)
# Generate: openssl rand -base64 32
AUTH_SECRET=여기에_랜덤_시크릿
# Local: http://localhost:3000 | Production: https://your-domain.com
AUTH_URL=http://localhost:3000

# Google — https://console.cloud.google.com/apis/credentials
# Redirect: {AUTH_URL}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Kakao — https://developers.kakao.com/console/app
# REST API 키 + Client Secret (보안 탭에서 생성)
# Redirect: {AUTH_URL}/api/auth/callback/kakao
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
# 카카오 콘솔에서 '카카오계정(이메일)' 동의항목 설정 후 1로 켜면 구글·카카오 크레딧 통합에 도움이 됩니다.
AUTH_KAKAO_REQUEST_EMAIL=
